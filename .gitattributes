# Normalize text files to LF
* text=auto

# Source code and project files
*.cs     text eol=lf
*.csproj text eol=lf
*.xml    text eol=lf
*.md     text eol=lf

# Build and configuration
Dockerfile* text eol=lf
*.json   text eol=lf
*.sh     text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Windows scripts
*.bat    text eol=crlf
*.cmd    text eol=crlf
*.ps1    text eol=crlf

# Binary files
*.dll    binary
*.pdb    binary
*.png    binary
*.jpg    binary
*.ogg    binary